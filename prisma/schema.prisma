generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  githubId     String        @unique
  githubLogin  String        @unique
  name         String
  birthDate    DateTime?     @map("birth_date")
  avatarUrl    String?       @map("avatar_url")
  gender       String        @default("NAO_ESPECIFICADO")
  createdAt    DateTime      @default(now()) @map("created_at")
  foods        Food[]
  healthData   HealthData[]
  meals        Meal[]
  waterIntakes WaterIntake[]
  weightLogs   WeightLog[]
  workouts     Workout[]

  @@map("users")
}

model Meal {
  id          Int        @id @default(autoincrement())
  type        String
  eatTime     DateTime   @map("eat_time")
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  userId      Int        @map("user_id")
  foods       MealFood[]
  user        User       @relation(fields: [userId], references: [id])

  @@map("meals")
}

model Food {
  id              Int        @id @default(autoincrement())
  name            String
  caloriesPer100g Float      @map("calories_per_100g")
  carbsPer100g    Float      @map("carbs_per_100g")
  proteinPer100g  Float      @map("protein_per_100g")
  fatPer100g      Float      @map("fat_per_100g")
  userId          Int        @map("user_id")
  user            User       @relation(fields: [userId], references: [id])
  meals           MealFood[]

  @@map("foods")
}

model MealFood {
  mealId   Int   @map("meal_id")
  foodId   Int   @map("food_id")
  foodG    Float @map("food_g")
  calories Float
  carbs    Float
  protein  Float
  fat      Float
  food     Food  @relation(fields: [foodId], references: [id])
  meal     Meal  @relation(fields: [mealId], references: [id])

  @@id([mealId, foodId])
  @@map("meal_foods")
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  height    Float
  weight    Float
  createdAt DateTime @default(now()) @map("created_at")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])

  @@map("weight_logs")
}

model HealthData {
  id              Int       @id @default(autoincrement())
  targetDietDaily Int       @map("target_diet_daily")
  levelActivity   String    @map("level_activity")
  createdAt       DateTime  @default(now()) @map("created_at")
  closedAt        DateTime? @map("closed_at")
  isActive        Boolean   @default(true) @map("is_active")
  userId          Int       @map("user_id")
  user            User      @relation(fields: [userId], references: [id])

  @@map("health_data")
}

model WaterIntake {
  id        String   @id @default(uuid())
  userId    Int      @map("user_id")
  amount    Int
  date      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("water_intakes")
}

model Workout {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workouts")
}